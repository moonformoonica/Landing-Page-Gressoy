# Contoh isian environment variable. Salin jadi .env untuk dipakai lokal
# (.env sendiri tidak ikut ke repo).

# API key Google Cloud dengan "Places API (New)" aktif.
# Dipakai HANYA di sisi server (api/rating.js), tidak pernah dikirim ke browser.
# Di Vercel: Settings > Environment Variables, nama harus persis seperti ini.
GOOGLE_PLACES_API_KEY=
